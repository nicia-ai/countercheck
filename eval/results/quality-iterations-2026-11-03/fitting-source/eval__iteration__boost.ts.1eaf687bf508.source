import { z } from "zod";
import { auc, wilson } from "../metrics.js";
import { isUncertainFixture, sha256, type Pair } from "../types.js";
import {
  calibrationMetrics,
  contentKey,
  foldGroups,
  groupKey,
  type CalibrationInput,
  type CalibrationRow,
} from "./calibrate.js";
import { CANDIDATE_IDS, type CandidateId } from "./profiles.js";

export const BOOST_GRID = [
  { depth: 1, l2: 10 },
  { depth: 1, l2: 50 },
  { depth: 2, l2: 10 },
  { depth: 2, l2: 50 },
] as const;
const ROUNDS = 50,
  RATE = 0.05,
  MIN_LEAF = 15;
const FIELDS = [
  "conflict",
  "logit_conflict",
  "negative",
  "logit_negative",
  "unknown",
  "scope",
  "applicability",
  "applicability_missing",
  "determinable",
  "determinable_missing",
  "quantitative_decisive",
  "quantitative_missing",
  "numeric_probability",
  "numeric_missing",
  "numeric_incompatible",
  "numeric_compatible",
  "numeric_available",
  "nli_entailment",
  "nli_neutral",
] as const;
type Config = { depth: 1 | 2; l2: 10 | 50 };
const sigmoid = (x: number) => (x >= 0 ? 1 / (1 + Math.exp(-x)) : Math.exp(x) / (1 + Math.exp(x)));
const logit = (p: number) =>
  Math.log(Math.max(0.001, Math.min(0.999, p)) / (1 - Math.max(0.001, Math.min(0.999, p))));
function vector(row: CalibrationRow) {
  const f = row.features,
    p =
      (row.raw_answers.q_0_relation as { probabilities?: Record<string, number> } | undefined)
        ?.probabilities ?? {},
    total = Object.values(p).reduce((a, b) => a + b, 0) || 1;
  return [
    f.conflict,
    logit(f.conflict),
    f.negative,
    logit(f.negative),
    f.unknown,
    f.scope,
    f.applicability ?? 0,
    Number(f.applicability === null),
    f.determinable ?? 0,
    Number(f.determinable === null),
    f.quantitative_decisive ?? 0,
    Number(f.quantitative_decisive === null),
    f.numeric_probability ?? 0,
    Number(f.numeric_probability === null),
    Number(f.numeric_relation === "incompatible"),
    Number(f.numeric_relation === "compatible"),
    Number(f.numeric_available),
    (p.entailment ?? 0) / total,
    (p.neutral ?? 0) / total,
  ];
}
type Case = { pair: Pair; rows: CalibrationRow[]; x: number[] };
function matched(input: CalibrationInput, profiles: readonly CandidateId[]): Case[] {
  if (
    profiles.length < 2 ||
    new Set(profiles).size !== profiles.length ||
    input.rows.length !== input.manifest.pairs.length * profiles.length
  )
    throw new Error("Boost requires complete matched multi-candidate coverage.");
  const index = new Map<string, CalibrationRow>();
  for (const row of input.rows) {
    const key = JSON.stringify([row.pair.id, row.profile]);
    if (index.has(key)) throw new Error("Duplicate boost case.");
    index.set(key, row);
  }
  return input.manifest.pairs.map((pair) => {
    const rows = profiles.map((profile) => {
      const row = index.get(JSON.stringify([pair.id, profile]));
      if (!row || contentKey(row.pair) !== contentKey(pair))
        throw new Error("Unmatched boost identity.");
      return row;
    });
    return { pair, rows, x: rows.flatMap(vector) };
  });
}
export type BoostTree =
  | { kind: "leaf"; value: number }
  | { kind: "split"; feature: number; threshold: number; left: BoostTree; right: BoostTree };
export type BoostModel = {
  intercept: number;
  dimensions: number;
  config: Config;
  rounds: 50;
  rate: 0.05;
  min_leaf: 15;
  training_cases: number;
  trees: BoostTree[];
};
function treeValue(tree: BoostTree, x: readonly number[]): number {
  return tree.kind === "leaf"
    ? tree.value
    : treeValue(x[tree.feature]! <= tree.threshold ? tree.left : tree.right, x);
}
export function predictBoost(model: BoostModel, x: readonly number[]): number {
  if (x.length !== model.dimensions || x.some((v) => !Number.isFinite(v)))
    throw new Error("Invalid boost feature dimensions.");
  return sigmoid(
    model.intercept + model.rate * model.trees.reduce((sum, t) => sum + treeValue(t, x), 0),
  );
}
function train(cases: readonly Case[], config: Config): BoostModel {
  const data = cases.filter((c) => !isUncertainFixture(c.pair)),
    n = data.length,
    d = data[0]?.x.length ?? 0;
  const positives = data.filter((c) => c.pair.gold === "contradiction").length;
  if (!positives || positives === n || n < MIN_LEAF * 2)
    throw new Error("Boost fitting requires both labels and at least30 training cases.");
  const intercept = logit(positives / n),
    margins = Array<number>(n).fill(intercept),
    indices = Array.from({ length: n }, (_, i) => i),
    trees: BoostTree[] = [];
  const sorted = Array.from({ length: d }, (_, j) =>
    [...indices].sort((a, b) => data[a]!.x[j]! - data[b]!.x[j]!),
  );
  for (let round = 0; round < ROUNDS; round++) {
    const probability = margins.map(sigmoid),
      g = probability.map((p, i) => Number(data[i]!.pair.gold === "contradiction") - p),
      h = probability.map((p) => p * (1 - p));
    function grow(rows: number[], depth: number): BoostTree {
      const G = rows.reduce((s, i) => s + g[i]!, 0),
        H = rows.reduce((s, i) => s + h[i]!, 0),
        leaf: BoostTree = { kind: "leaf", value: G / (H + config.l2) };
      if (depth === 0 || rows.length < MIN_LEAF * 2) return leaf;
      const membership = new Uint8Array(n);
      for (const i of rows) membership[i] = 1;
      let gain = 1e-9,
        best: { feature: number; threshold: number } | undefined;
      for (let feature = 0; feature < d; feature++) {
        const order = sorted[feature]!.filter((i) => membership[i]);
        let leftG = 0,
          leftH = 0;
        for (let j = 0; j < order.length - 1; j++) {
          const i = order[j]!;
          leftG += g[i]!;
          leftH += h[i]!;
          if (j + 1 < MIN_LEAF || order.length - j - 1 < MIN_LEAF) continue;
          const a = data[i]!.x[feature]!,
            b = data[order[j + 1]!]!.x[feature]!;
          if (a === b) continue;
          const improvement =
            (leftG * leftG) / (leftH + config.l2) +
            (G - leftG) ** 2 / (H - leftH + config.l2) -
            (G * G) / (H + config.l2);
          if (improvement > gain) {
            gain = improvement;
            best = { feature, threshold: (a + b) / 2 };
          }
        }
      }
      if (!best) return leaf;
      return {
        kind: "split",
        ...best,
        left: grow(
          rows.filter((i) => data[i]!.x[best.feature]! <= best.threshold),
          depth - 1,
        ),
        right: grow(
          rows.filter((i) => data[i]!.x[best.feature]! > best.threshold),
          depth - 1,
        ),
      };
    }
    const tree = grow(indices, config.depth);
    trees.push(tree);
    for (let i = 0; i < n; i++) margins[i]! += RATE * treeValue(tree, data[i]!.x);
  }
  return {
    intercept,
    dimensions: d,
    config,
    rounds: ROUNDS,
    rate: RATE,
    min_leaf: MIN_LEAF,
    training_cases: n,
    trees,
  };
}
type Scored = { item: Case; score: number };
type Policy = { positive: number; negative_cut: number };
const score = (cases: readonly Case[], model: BoostModel): Scored[] =>
  cases.map((item) => ({ item, score: predictBoost(model, item.x) }));
function loss(rows: readonly Scored[]) {
  const binary = rows.filter((r) => !isUncertainFixture(r.item.pair));
  if (!binary.length) throw new Error("Boost CV fold lacks binary labels.");
  return (
    binary.reduce((s, r) => {
      const p = Math.max(1e-15, Math.min(1 - 1e-15, r.score));
      return s - (r.item.pair.gold === "contradiction" ? Math.log(p) : Math.log1p(-p));
    }, 0) / binary.length
  );
}
function metrics(rows: readonly Scored[], policy: Policy) {
  const projected = rows.map(
    ({ item, score }) =>
      ({
        pair: item.pair,
        profile: item.rows[0]!.profile,
        raw_answers: {},
        features: {
          conflict: score,
          negative: 1 - score,
          unknown: 0,
          scope: 0,
          applicability: null,
          determinable: null,
          quantitative_decisive: null,
          numeric_probability: null,
          numeric_relation: null,
          numeric_available: false,
        },
      }) satisfies CalibrationRow,
  );
  const m = calibrationMetrics(projected, { ...policy, negative_support: 0 }),
    binary = rows.filter((r) => !isUncertainFixture(r.item.pair));
  return {
    ...m,
    npv: wilson(m.tn, m.tn + m.false_clears),
    ...auc(binary.map((r) => ({ y: r.item.pair.gold === "contradiction", score: r.score }))),
    log_loss: binary.length ? loss(rows) : null,
    brier: binary.length
      ? binary.reduce(
          (s, r) => s + (r.score - Number(r.item.pair.gold === "contradiction")) ** 2,
          0,
        ) / binary.length
      : null,
  };
}
function policies(rows: readonly Scored[]) {
  const thresholds = [
    ...new Set([
      0,
      ...Array.from({ length: 101 }, (_, i) => i / 100),
      ...rows.map((r) => r.score),
      1.000001,
    ]),
  ].sort((a, b) => a - b);
  const positive_frontier = thresholds.map((positive) => {
    const m = metrics(rows, { positive, negative_cut: -1 });
    return {
      threshold: positive,
      tp: m.tp,
      fp: m.fp,
      precision: m.precision.value,
      recall: m.recall.value,
    };
  });
  const eligible = positive_frontier
      .filter((p) => p.tp > 0 && (p.precision ?? 0) >= 0.95)
      .sort((a, b) => b.tp - a.tp || b.precision! - a.precision! || b.threshold - a.threshold),
    positive = eligible[0]?.threshold ?? 1.000001;
  const negative_frontier = [-1, ...thresholds.filter((v) => v < positive && v <= 1)].map((cut) => {
    const m = metrics(rows, { positive, negative_cut: cut });
    return {
      cut,
      tn: m.tn,
      false_clears: m.false_clears,
      npv: m.npv.value,
      coverage: m.clear_negative_coverage.value,
    };
  });
  const best = (npv: boolean) =>
    negative_frontier
      .filter((p) => (npv ? (p.npv ?? 0) >= 0.95 : p.false_clears === 0))
      .sort((a, b) => b.tn - a.tn || a.false_clears - b.false_clears || a.cut - b.cut)[0]?.cut ??
    -1;
  return {
    positive_precision_target_met: eligible.length > 0,
    policies: {
      zero_false_clears: { positive, negative_cut: best(false) },
      npv95: { positive, negative_cut: best(true) },
    },
    positive_frontier,
    negative_frontier,
  };
}
function reports(rows: readonly Scored[], selection: Record<string, Policy>) {
  return Object.fromEntries(
    Object.entries(selection).map(([name, p]) => [
      name,
      {
        policy: p,
        metrics: metrics(rows, p),
        by_dataset: Object.fromEntries(
          [...new Set(rows.map((r) => r.item.pair.dataset))].map((d) => [
            d,
            metrics(
              rows.filter((r) => r.item.pair.dataset === d),
              p,
            ),
          ]),
        ),
      },
    ]),
  );
}
const configSchema = z.strictObject({
  depth: z.union([z.literal(1), z.literal(2)]),
  l2: z.union([z.literal(10), z.literal(50)]),
});
const treeSchema: z.ZodType<BoostTree> = z.lazy(() =>
  z.discriminatedUnion("kind", [
    z.strictObject({ kind: z.literal("leaf"), value: z.number().finite() }),
    z.strictObject({
      kind: z.literal("split"),
      feature: z.number().int().nonnegative(),
      threshold: z.number().finite(),
      left: treeSchema,
      right: treeSchema,
    }),
  ]),
);
const boostModelSchema = z.strictObject({
  intercept: z.number().finite(),
  dimensions: z.number().int().positive(),
  config: configSchema,
  rounds: z.literal(50),
  rate: z.literal(0.05),
  min_leaf: z.literal(15),
  training_cases: z.number().int().min(30),
  trees: z.array(treeSchema).length(50),
});
const hash = z.string().regex(/^[a-f0-9]{64}$/),
  policySchema = z.strictObject({
    positive: z.number().min(0).max(1.000001),
    negative_cut: z.number().min(-1).max(1),
  });
export const boostedModelSchema = z
  .object({
    schema_version: z.literal(1),
    kind: z.enum(["iteration-boosted-fusion", "iteration-boosted-fusion-diagnostic"]),
    qualification: z.literal("not_assessed"),
    estimate_interpretation: z.literal(
      "fitted boosted binary estimate; independent calibration unverified",
    ),
    profiles: z.array(z.enum(CANDIDATE_IDS)).min(2),
    feature_names: z.array(z.string()),
    candidate_source_sha256: hash,
    training_manifest_sha256: hash,
    training_run_sha256: hash,
    training_groups: z.array(z.string()).min(5),
    training_sources: z.array(z.string()),
    training_content: z.array(hash),
    training_groups_sha256: hash,
    seed: z.string().min(1),
    threshold_source: z.literal("pooled_group_oof"),
    model: boostModelSchema,
    selection: z
      .object({
        policies: z.strictObject({ zero_false_clears: policySchema, npv95: policySchema }),
      })
      .passthrough(),
    cross_validation: z.strictObject({
      method: z.literal("three_group_folds_minimum_oof_log_loss"),
      grid: z.array(configSchema).length(4),
      selected: configSchema,
      folds: z
        .array(
          z.strictObject({
            index: z.number().int().min(0).max(2),
            fit_groups: z.array(z.string()).min(1),
            check_groups: z.array(z.string()).min(1),
            fit_groups_sha256: hash,
            check_groups_sha256: hash,
          }),
        )
        .length(3),
      losses: z
        .array(
          z.strictObject({
            config: configSchema,
            log_loss: z.number().finite().nonnegative(),
            fold_log_loss: z.array(z.number().finite().nonnegative()).length(3),
          }),
        )
        .length(4),
      oof_predictions: z
        .array(
          z.strictObject({
            pair_id: z.string(),
            group: z.string(),
            fold: z.number().int().min(0).max(2),
            score: z.number().finite().min(0).max(1),
          }),
        )
        .min(1),
    }),
  })
  .passthrough()
  .superRefine((value, ctx) => {
    const expected = value.profiles.flatMap((p) => FIELDS.map((f) => `${p}:${f}`)),
      cv = value.cross_validation,
      groups = value.training_groups;
    const validTree = (tree: BoostTree, depth: number): boolean =>
      tree.kind === "leaf" ||
      (depth > 0 &&
        tree.feature < expected.length &&
        validTree(tree.left, depth - 1) &&
        validTree(tree.right, depth - 1));
    const compare = (
      a: { config: Config; log_loss: number },
      b: { config: Config; log_loss: number },
    ) =>
      Math.abs(a.log_loss - b.log_loss) <= 1e-12
        ? a.config.depth - b.config.depth || b.config.l2 - a.config.l2
        : a.log_loss - b.log_loss;
    const selected = [...cv.losses].sort(compare)[0]!.config;
    if (
      JSON.stringify([...new Set(value.profiles)].sort()) !== JSON.stringify(value.profiles) ||
      JSON.stringify(expected) !== JSON.stringify(value.feature_names) ||
      value.model.dimensions !== expected.length ||
      !value.model.trees.every((t) => validTree(t, value.model.config.depth))
    )
      ctx.addIssue({ code: "custom", message: "Invalid boosted feature/tree dimensions." });
    const checkMembership = cv.folds.flatMap((f) => f.check_groups);
    if (
      sha256(JSON.stringify(groups)) !== value.training_groups_sha256 ||
      new Set(groups).size !== groups.length ||
      new Set(checkMembership).size !== checkMembership.length ||
      JSON.stringify([...checkMembership].sort()) !== JSON.stringify([...groups].sort()) ||
      cv.folds.some(
        (f, i) =>
          f.index !== i ||
          new Set(f.fit_groups).size !== f.fit_groups.length ||
          f.fit_groups.some((g) => f.check_groups.includes(g)) ||
          JSON.stringify([...f.fit_groups, ...f.check_groups].sort()) !==
            JSON.stringify([...groups].sort()) ||
          f.fit_groups_sha256 !== sha256(JSON.stringify(f.fit_groups)) ||
          f.check_groups_sha256 !== sha256(JSON.stringify(f.check_groups)),
      )
    )
      ctx.addIssue({ code: "custom", message: "Invalid boosted source-group folds." });
    if (
      JSON.stringify(cv.grid) !== JSON.stringify(BOOST_GRID) ||
      JSON.stringify(cv.losses.map((l) => l.config)) !== JSON.stringify(BOOST_GRID) ||
      JSON.stringify(cv.selected) !== JSON.stringify(selected) ||
      JSON.stringify(value.model.config) !== JSON.stringify(selected) ||
      cv.oof_predictions.length < value.model.training_cases ||
      new Set(cv.oof_predictions.map((p) => p.pair_id)).size !== cv.oof_predictions.length ||
      groups.some((g) => !cv.oof_predictions.some((p) => p.group === g)) ||
      cv.oof_predictions.some((p) => !cv.folds[p.fold]!.check_groups.includes(p.group))
    )
      ctx.addIssue({ code: "custom", message: "Invalid boosted CV selection or OOF coverage." });
  });
export function fitBoost(input: CalibrationInput, options: { seed: string; diagnostic?: boolean }) {
  if (
    input.purpose !== "tune" ||
    input.manifest.purpose !== "development" ||
    input.manifest.pairs.some((p) => p.split !== "train")
  )
    throw new Error("Boost fit requires tune purpose and original train only.");
  if (!options.seed) throw new Error("Boost needs a source-group seed.");
  const profiles = [...input.profiles].sort(),
    cases = matched(input, profiles);
  foldGroups(input.manifest.pairs, options.seed);
  const groups = [...new Set(input.manifest.pairs.map(groupKey))].sort(),
    ordered = [...groups].sort((a, b) =>
      sha256(`${options.seed}:boost:${a}`).localeCompare(sha256(`${options.seed}:boost:${b}`)),
    );
  const folds = Array.from({ length: 3 }, (_, index) => {
    const fit_groups = ordered.filter((_, i) => i % 3 !== index),
      check_groups = ordered.filter((_, i) => i % 3 === index);
    return {
      index,
      fit_groups,
      check_groups,
      fit_groups_sha256: sha256(JSON.stringify(fit_groups)),
      check_groups_sha256: sha256(JSON.stringify(check_groups)),
    };
  });
  const runs = BOOST_GRID.map((config) => {
    const parts = folds.map((f) => {
      const fit = new Set(f.fit_groups),
        check = new Set(f.check_groups),
        model = train(
          cases.filter((c) => fit.has(groupKey(c.pair))),
          config,
        ),
        scores = score(
          cases.filter((c) => check.has(groupKey(c.pair))),
          model,
        );
      return { fold: f.index, scores, log_loss: loss(scores) };
    });
    const scores = parts.flatMap((p) => p.scores);
    return { config, parts, scores, log_loss: loss(scores) };
  });
  const selected = [...runs].sort((a, b) =>
      Math.abs(a.log_loss - b.log_loss) <= 1e-12
        ? a.config.depth - b.config.depth || b.config.l2 - a.config.l2
        : a.log_loss - b.log_loss,
    )[0]!,
    model = train(cases, selected.config),
    selection = policies(selected.scores);
  return {
    schema_version: 1 as const,
    kind: options.diagnostic
      ? ("iteration-boosted-fusion-diagnostic" as const)
      : ("iteration-boosted-fusion" as const),
    qualification: "not_assessed" as const,
    estimate_interpretation:
      "fitted boosted binary estimate; independent calibration unverified" as const,
    profiles,
    feature_names: profiles.flatMap((p) => FIELDS.map((f) => `${p}:${f}`)),
    candidate_source_sha256: input.source_sha256,
    training_manifest_sha256: input.manifest_sha256,
    training_run_sha256: input.run_sha256,
    training_groups: groups,
    training_sources: [
      ...new Set(input.manifest.pairs.map((p) => `${p.dataset}:${p.source_id}`)),
    ].sort(),
    training_content: [...new Set(input.manifest.pairs.map(contentKey))].sort(),
    training_groups_sha256: sha256(JSON.stringify(groups)),
    seed: options.seed,
    threshold_source: "pooled_group_oof" as const,
    model,
    selection,
    first_pass_only: true,
    ignored_repeat_passes: input.passes - 1,
    cross_validation: {
      method: "three_group_folds_minimum_oof_log_loss" as const,
      grid: [...BOOST_GRID],
      selected: selected.config,
      folds,
      losses: runs.map((r) => ({
        config: r.config,
        log_loss: r.log_loss,
        fold_log_loss: r.parts.map((p) => p.log_loss),
      })),
      oof_predictions: selected.parts.flatMap((p) =>
        p.scores.map((r) => ({
          pair_id: r.item.pair.id,
          group: groupKey(r.item.pair),
          fold: p.fold,
          score: r.score,
        })),
      ),
    },
    oof: reports(selected.scores, selection.policies),
    training: reports(score(cases, model), selection.policies),
  };
}
export function evaluateBoost(modelValue: unknown, input: CalibrationInput) {
  const model = boostedModelSchema.parse(modelValue);
  if (
    model.kind !== "iteration-boosted-fusion" ||
    !["validation", "regression"].includes(input.purpose)
  )
    throw new Error(
      "Frozen boost evaluation requires a fitted model and independent validation/regression role.",
    );
  if (
    model.candidate_source_sha256 !== input.source_sha256 ||
    JSON.stringify(model.profiles) !== JSON.stringify([...input.profiles].sort())
  )
    throw new Error("Boost source/profile identity mismatch.");
  const groups = new Set(model.training_groups),
    sources = new Set(model.training_sources),
    contents = new Set(model.training_content);
  if (
    input.manifest.pairs.some(
      (p) =>
        groups.has(groupKey(p)) ||
        sources.has(`${p.dataset}:${p.source_id}`) ||
        contents.has(contentKey(p)),
    )
  )
    throw new Error("Boost training/validation source groups or content overlap.");
  const scores = score(matched(input, model.profiles), model.model);
  return {
    kind: "iteration-frozen-boost-validation",
    qualification: "not_assessed",
    model_sha256: sha256(JSON.stringify(modelValue)),
    manifest_sha256: input.manifest_sha256,
    run_sha256: input.run_sha256,
    policies: reports(scores, model.selection.policies),
    observations: scores.map(({ item, score }) => ({
      pair_id: item.pair.id,
      calibrated_estimate: { contradiction: score, no_contradiction: 1 - score },
      estimate_interpretation: model.estimate_interpretation,
      raw_candidates: item.rows.map((r) => ({
        profile: r.profile,
        features: r.features,
        raw_answers: r.raw_answers,
      })),
    })),
  };
}

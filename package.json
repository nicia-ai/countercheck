{
  "name": "countercheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm build:dashboard && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "pnpm build:dashboard && vitest run",
    "build": "pnpm build:dashboard && wrangler deploy --dry-run --outdir dist",
    "smoke": "vitest run --project smoke",
    "eval:smoke": "tsx scripts/eval-smoke.ts",
    "eval:run": "tsx scripts/eval.ts",
    "eval:measure": "tsx scripts/measure-model.ts",
    "eval:prepare": "tsx scripts/prepare-eval.ts",
    "keys": "tsx scripts/keys.ts",
    "eval:engineering": "tsx scripts/engineering-eval.ts",
    "build:dashboard": "tsx scripts/build-dashboard.ts",
    "db:migrate:local": "wrangler d1 migrations apply countercheck --local",
    "control": "tsx scripts/control.ts",
    "ci:build": "pnpm check && pnpm test && pnpm build",
    "ci:deploy": "tsx scripts/ci-deploy.ts"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "miniflare": "5.20261103.0-beta",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "license": "Apache-2.0"
}
